# src/agent/config.env.example — kopieren nach config.env (neben das
# agent-Binary) und Werte setzen. Details: src/agent/README.md.
#
# Der Agent verwaltet ausschließlich Andora-Komponenten des lokalen
# Servers und benötigt keine Datenbankzugangsdaten.

# --- BINDUNG ---
# Dedizierter Management-Port, getrennt von Spiel-Ports
# (3001/3002/3003/8080/8081/8082/11434).
AGENT_PORT=9443
# "" | auto   alle Interfaces (Standard)
# ipv4 | 4    nur IPv4 (0.0.0.0)
# ipv6 | 6    nur IPv6 ([::])
# dual | both explizit dual-stack (0.0.0.0 + [::])
# IP-Literal oder Hostname (auch IPv6, geklammert oder ungeklammert)
AGENT_BIND_HOST=

# --- AUTHENTIFIZIERUNG (Zwischenlösung) ---
# Shared Secret für den lokalen Panel-Aufruf. Erforderlich.
# Bei leerem Wert verweigert der Agent alle Management-Requests (fail-closed).
# Spätere mTLS-Umsetzung: AGENT_CA_FILE / AGENT_CLIENT_CERT_FILE / AGENT_CLIENT_KEY_FILE.
AGENT_TOKEN=CHANGE_ME

# --- VERWALTETE DIENSTE ---
# Komma-getrennte Liste von eindeutigen Keys (Großbuchstaben, Zahlen, _ und -).
AGENT_SERVICES=coordinator,realm

# Für jeden Key: UNIT (systemd unit), URL (Health-Status, optional),
# HEALTH_PATH (Pfad-Endpunkt, default /health).
#
# Beispiel Realm (Rust-Realm):
AGENT_SERVICE_REALM_UNIT=andora-realm.service
AGENT_SERVICE_REALM_URL=http://127.0.0.1:3002
AGENT_SERVICE_REALM_HEALTH_PATH=/health

# Beispiel Coordinator:
AGENT_SERVICE_COORDINATOR_UNIT=andora-coordinator.service
AGENT_SERVICE_COORDINATOR_URL=http://127.0.0.1:8082
AGENT_SERVICE_COORDINATOR_HEALTH_PATH=/health

# Beispiele Auth/Login (auskommentiert, je nach Deployment aktivieren):
#AGENT_SERVICE_AUTH_UNIT=andora-auth.service
#AGENT_SERVICE_AUTH_URL=http://127.0.0.1:8080
#AGENT_SERVICE_AUTH_HEALTH_PATH=/health
#AGENT_SERVICE_LOGIN_UNIT=andora-login.service
#AGENT_SERVICE_LOGIN_URL=http://127.0.0.1:8081
#AGENT_SERVICE_LOGIN_HEALTH_PATH=/health

# --- SYSTEMCTL / SUDO ---
# Pfad zum systemctl-Binary (Standard /usr/bin/systemctl).
AGENT_SYSTEMCTL=/usr/bin/systemctl
# Pfad zum journalctl-Binary (Standard /usr/bin/journalctl).
AGENT_JOURNALCTL=/usr/bin/journalctl
# Pfad zum sudo-Binary (Standard /usr/bin/sudo).
AGENT_SUDO=/usr/bin/sudo
# Start/Stop/Restart via sudo -n (NOPASSWD-Sudoers-Regel erforderlich).
AGENT_SUDO_ENABLED=true

# --- LOGS ---
# Maximale Zeilenanzahl (1..10000, Standard 200).
AGENT_LOG_LINE_LIMIT=200
# Maximale Bytegröße der Log-Antwort (Standard 128KB).
AGENT_LOG_BYTE_LIMIT=131072

# --- HEALTH-PROBE ---
# Timeout für Health-/Status-Abfragen (Millisekunden, min 100).
AGENT_PROBE_TIMEOUT_MS=1500

# --- TLS (optional, Server-seitig) ---
#TLS_CERT_FILE=
#TLS_KEY_FILE=

# --- mTLS (strukturierte Vorbereitung, zukünftig) ---
# Alle drei mTLS-Werte UND Server-TLS (TLS_CERT_FILE + TLS_KEY_FILE)
# müssen gesetzt sein, sonst verweigert der Agent den Start
# (keine stille Abschwächung auf Plain-HTTP).
#AGENT_CA_FILE=
#AGENT_CLIENT_CERT_FILE=
#AGENT_CLIENT_KEY_FILE=
