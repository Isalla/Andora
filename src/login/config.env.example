# src/login/config.env.example — kopieren nach config.env und Werte setzen.
# Der Login-Service besitzt KEINE Datenbank-Zugangsdaten. Er spricht
# ausschließlich mit dem Auth/API-Service (eigene Service-Credential).
LOGIN_PORT=8081

# --- Bind-Host (welche Interfaces der Listener belegt) ---
# "" | auto   alle Interfaces (Standard)
# ipv4 | 4    nur IPv4 (0.0.0.0)
# ipv6 | 6    nur IPv6 ([::])
# dual | both explizit dual-stack (0.0.0.0 + [::])
# IP-Literal   z. B. 192.0.2.10, ::1 (geklammert oder ungeklammert)
# Hostname     wird beim Start aufgelöst, ein Listener je Familie
LOGIN_BIND_HOST=

# --- Vertrauenswürdige Proxys (X-Forwarded-For / X-Real-IP) ---
# Kommagetrennte Liste von IPs/CIDRs; leer = Header werden ignoriert
# (der Login-Service vertraut ihnen nur, wenn die Client-Adresse hier liegt).
TRUSTED_PROXIES=

# --- Auth/API-Service (Go, src/api) ---
# IPv6-Host darf ungeklammert als host:port angegeben werden (wird zu [host]:port).
AUTHAPI_URL=http://127.0.0.1:8080
LOGIN_SERVICE_ID=login-service
LOGIN_SERVICE_SECRET=CHANGE_ME
# Die login-service-Credential braucht auf Auth-Seite (SERVICE_login_*):
# account.authenticate,session.validate,realm.list,handoff.create
# (+ session.revoke nur falls /logout dort liegen soll — Standard:
# session.revoke, siehe README).

# --- Realm-Spieladressen (werden in /handoff-Antworten mitgegeben) ---
# Format: id=url,id=url ( operator Deployment-Konfiguration ).
# Realms ohne Eintrag erhalten ws_url:"" in der Handoff-Antwort.
# IPv6-Host darf ungeklammert als host:port angegeben werden (wird zu [host]:port).
REALM_WS_URLS=1=ws://127.0.0.1:3001

# --- Optionale Härtung ---
AUTHAPI_TIMEOUT_MS=5000
RATE_LIMIT_BURST=10
RATE_LIMIT_PER_MIN=120
#TLS_CERT_FILE=
#TLS_KEY_FILE=
