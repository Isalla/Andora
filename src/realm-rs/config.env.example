# src/realm-rs/config.env.example — kopieren nach config.env (neben das
# andora-realm-Binary) und Werte setzen. Zielarchitektur: GENAU EINE
# Realm-Datenbank (realm_state_<realm>). Keine character-/world_data-DBs.
PORT_WS=3001
PORT_HTTP=3002

# Bind-Hosts der Listener (WebSocket-Welt-Server bzw. Health/Status-HTTP).
# Leer = alle Interfaces (Standard). Moegliche Werte (identisch fuer beide):
#   "" | auto   alle Interfaces (Standard)
#   ipv4 | 4    nur IPv4 (0.0.0.0)
#   ipv6 | 6    nur IPv6 ([::])
#   dual | both explizit dual-stack (0.0.0.0 + [::])
#   IP-Literal oder Hostname (z. B. 192.168.1.5, ::1, gameserver.local)
# IPv6-Literale: gecklammert ODER ungeklammert als host:port (wird zu
# [host]:port), z. B. ::1:3001.
WS_BIND_HOST=
HEALTH_BIND_HOST=

# Eigene Realm-ID (Handoff-Bindung: nur Handoffs für diese ID werden
# akzeptiert) und eigene Realm-Datenbank (eigener DB-Benutzer, der nur
# diese EINE Datenbank sieht).
REALM_ID=1
REALM_STATE_DB_HOST=
REALM_STATE_DB_PORT=3306
REALM_STATE_DB_USER=
REALM_STATE_DB_PASSWORD=
REALM_STATE_DB_NAME=realm_state_de1

# --- AUTH-API (separater Go-Dienst) ---
# Eigene Service-Credential dieses Realms (Berechtigungen u. a.:
# handoff.validate, session.validate, parental.status, parental.pin).
# Leere AUTHAPI_URL = Auth-Anbindung bewusst deaktiviert (nur Dev/Test).
# IPv6-Host darf ungeklammert als host:port angegeben werden (wird zu [host]:port).
AUTHAPI_URL=http://127.0.0.1:8080
AUTHAPI_SERVICE_ID=realm-de1-service
AUTHAPI_SERVICE_SECRET=CHANGE_ME

# --- SQL-MIGRATIONEN (automatisch beim Start, eigene db_version) ---
# Standard: migrations/ neben dem Binary. Nur bei abweichender Ablage setzen.
#REALM_STATE_MIGRATIONS_DIR=
# Destruktive Migrationen nur nach Backup im Update-Ablauf freigeben.
ALLOW_DESTRUCTIVE_MIGRATIONS=0

TICK_MS=100
AOFB_RADIUS=20
RENDER_CAP_DEFAULT=64
# IPv6-Host darf ungeklammert als host:port angegeben werden (wird zu [host]:port).
OLLAMA_URL=http://192.168.1.32:11434

# --- COMBAT V1 (vorläufige Balancingwerte, docs/Kampfsystem.md §§4–7) ---
# Waffen-/Kampfskill (skills-Tabelle); Level startet bei 1.
COMBAT_WEAPON_SKILL_ID=schwerter
# Grundschaden und Duration (ms) der V1-Platzhalter-Waffe sowie Reichweite.
COMBAT_WEAPON_DAMAGE=10
COMBAT_WEAPON_DURATION_MS=2000
COMBAT_WEAPON_RANGE=2.0
# Trefferwahrscheinlichkeiten in Promille (Miss/Dodge/Parry/Block/Crit).
COMBAT_HIT_MISS_PERMILLE=100
COMBAT_HIT_DODGE_PERMILLE=100
COMBAT_HIT_PARRY_PERMILLE=50
COMBAT_HIT_BLOCK_PERMILLE=100
COMBAT_HIT_CRIT_PERMILLE=100
# Kritischer Schaden (Prozent) und Block-Reduktion (Prozent).
COMBAT_HIT_CRIT_MULT_PERCENT=150
COMBAT_HIT_BLOCK_REDUCE_PERCENT=50
# Rüstung: Prozentpunkte Reduktion je Rüstungspunkt + Klassen-Caps (Prozent).
COMBAT_ARMOR_PCT_PER_POINT=2
COMBAT_ARMOR_CAP_TANK=50
COMBAT_ARMOR_CAP_MAGE=20
COMBAT_ARMOR_CAP_DEFAULT=30
# Miss-Reduktion in Promille je Waffenskillpunkt über 1.
COMBAT_SKILL_HIT_BONUS_PERMILLE=5

# --- PROGRESSION V1 (docs/Erfahrung_und_Progressionssystem.md) ---
# EXP-Kurve: exp_needed(level) = base + factor * level² (aktuelles Level).
# Vorläufige Balancingwerte — werden erst durch Tests festgelegt (§3).
PROG_EXP_BASE=100
PROG_EXP_FACTOR=10
# Aktives Level-Cap (§4): Core 40, Erweiterung 50.
PROG_LEVEL_CAP=40
# Leveldifferenz (§7), anteilige Monster-EXP in Promille
# (Gegnerlevel − Charakterlevel): 5+ / 2–4 / ±1 / −2…−3 / −4…−5 / −6…−9 / −10+.
PROG_EXP_DIFF_PLUS5_PERMILLE=1250
PROG_EXP_DIFF_PLUS2TO4_PERMILLE=1100
PROG_EXP_DIFF_SAME_ZONE_PERMILLE=1000
PROG_EXP_DIFF_MINUS2TO3_PERMILLE=750
PROG_EXP_DIFF_MINUS4TO5_PERMILLE=500
PROG_EXP_DIFF_MINUS6TO9_PERMILLE=250
PROG_EXP_DIFF_MINUS10_PERMILLE=0

# --- SERVERAUTORITÄT & ANTI-MANIPULATION V1 (docs/Serverautoritaet_und_Anti-Manipulation_V1.md) ---
# Frühe, billige Netzwerkprüfung + gestaffelte Rate Limits (Mechanik, kein Balancing).
# Max. WS-Frame-Größe in Bytes (größere Frames werden vor dem Parsen verworfen).
SEC_MAX_FRAME_BYTES=65536
# Erlaubte Requests je 1000-ms-Fenster: Bewegung (häufig) vs. seltene Aktionen
# (Attributspunkte, Käufe, Handel, Crafting, Gruppe).
SEC_MOVE_PER_SEC=30
SEC_INTERACTIVE_PER_SEC=10
SEC_COMBAT_PER_SEC=10
SEC_RARE_PER_SEC=5
# Auffälligkeiten je Verbindung bis zum Disconnect (kein permanenter Bann).
SEC_DISCONNECT_AFTER_VIOLATIONS=50
