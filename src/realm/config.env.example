# src/realm/config.env.example — kopieren nach config.env und Werte setzen
PORT_WS=3001
PORT_HTTP=3002

# Vier getrennte Datenbankverbindungen: je DB eigene Konfiguration,
# eigener technischer MariaDB-Benutzer, eigener Connection-Pool.
# Es gibt keine WORLD_DB_*-Sammelkonfiguration und keinen DB_*-Legacy-Fallback.
# Fehlt eine notwendige DB_*-Konfiguration, bricht der Server mit klarer
# Fehlermeldung ab; es wird niemals stillschweigend eine andere DB verwendet.
# Die DBs duerfen aktuell auf demselben MariaDB-Server liegen; spaeter kann
# jede DB unabhaengig auf einen anderen DB-Server verschoben werden.

# --- AUTH-DB (Account/Auth/Session/Realm-Registrierung) ---
# Eigene Verbindung + eigener Pool. Nur der Auth-Service nutzt diese DB.
AUTH_DB_HOST=
AUTH_DB_PORT=3306
AUTH_DB_USER=
AUTH_DB_PASSWORD=
AUTH_DB_NAME=auth

# --- CHARACTER-DB (persoenliche Charakterdaten und Fortschritt) ---
# Eigene Verbindung + eigener Pool. Enthaelte kein Passwort/E-Mail-Geheimnis.
CHARACTER_DB_HOST=
CHARACTER_DB_PORT=3306
CHARACTER_DB_USER=
CHARACTER_DB_PASSWORD=
CHARACTER_DB_NAME=character

# --- WORLD DATA-DB (statische globale Weltdaten, im Betrieb zumeist lesend) ---
# Eigene Verbindung + eigener Pool. Aenderungen nur ueber migrations/, seed/.
WORLD_DATA_DB_HOST=
WORLD_DATA_DB_PORT=3306
WORLD_DATA_DB_USER=
WORLD_DATA_DB_PASSWORD=
WORLD_DATA_DB_NAME=world_data

# --- REALM STATE-DB (persistenter Zustand EINES konkreten Realms) ---
# DB-Name = realm_state_<realm>, z. B. realm_state_de1. Eigene Verbindung
# + eigener Pool. Kein Zugriff auf andere realm_state_<realm>-DBs.
REALM_STATE_DB_HOST=
REALM_STATE_DB_PORT=3306
REALM_STATE_DB_USER=
REALM_STATE_DB_PASSWORD=
REALM_STATE_DB_NAME=realm_state_de1

TICK_MS=100
AOFB_RADIUS=20
OLLAMA_URL=http://192.168.1.32:11434
# NPC-Sprache: Phi-4-mini = schnell, skalierbar bei vielen Spielern (Default)
OLLAMA_MODEL=hf.co/unsloth/Phi-4-mini-instruct-GGUF:Q4_K_M
# Optional: schweres Modell nur fuer Boss-/Raid-Dialoge (leere Zeile = aus)
OLLAMA_MODEL_QUALITY=qwen3.8:27b
OLLAMA_TIMEOUT_MS=15000
OLLAMA_FALLBACK=1
# Ollama-Kontextfenster (num_ctx): KLEIN lassen -> KV-Cache klein ->
# Modell bleibt im VRAM, wird nicht von der CPU gebremst. 8192 reicht fuer
# 2-Satz-NPC-Antworten + ~10 Chat-Vorgaenge. Groessere Werte = mehr VRAM.
OLLAMA_NUM_CTX=8192
# Sampling-Parameter (standardisiert, pro Modell anpassbar):
# Empfehlung Google fuer Gemma-Reihe: t=1.0 / top_p=0.95 / top_k=64.
# Fuer kleine Modelle (Phi-4-mini) eher t=0.8 testen -> weniger wirres Zeug.
OLLAMA_TEMPERATURE=0.8
OLLAMA_TOP_P=0.95
OLLAMA_TOP_K=64
# Pro Qualitaetsmodell (Boss) eigene Werte, leer = obige nutzen
OLLAMA_TEMP_QUALITY=1.0
RENDER_CAP_DEFAULT=64
