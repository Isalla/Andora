# src/coordinator/config.env.example — kopieren nach config.env (neben das
# coordinator-Binary) und Werte setzen. Details: docs/Coordinator.md.
#
# Der Coordinator hält KEINE Datenbankzugangsdaten (docs/Coordinator.md §2).
# Er spricht nur mit Ollama (rechte Seite) und den Realms (result/job-Query).

# --- BINDUNG ---
COORDINATOR_PORT=8082
# "" | auto   alle Interfaces (Standard)
# ipv4 | 4    nur IPv4 (0.0.0.0)
# ipv6 | 6    nur IPv6 ([::])
# dual | both explizit dual-stack (0.0.0.0 + [::])
# IP-Literal oder Hostname (auch IPv6, geklammert oder ungeklammert)
COORDINATOR_BIND_HOST=

# Persistenter Queue-/Job-Bereich (relativ zum Projektroot/Binary).
# Layout: queue/jobs/*.json, queue/queue.json, queue/done/, queue/quarantine/.
# Temporäre Dateien eines atomaren Schreibvorgangs liegen projektintern
# NUR hier (data), nie systemweit in /tmp.
COORDINATOR_DATA_DIR=data
# Verzeichnis mit den Sprachfilterdateien für die Inhaltsregeln (§9):
# <lang>.input.txt / <lang>.output.txt. Alle vorhandenen Sprachdateien
# werden beim Start geladen und gelten gemeinsam für ALLE Jobs, unabhängig
# von der Client-/Spielersprache. Fehlt das Verzeichnis, bleiben nur die
# INPUT_/OUTPUT_DENY_WORDS-Ergänzungen aktiv.
COORDINATOR_FILTER_DIR=filters

# --- OLLAMA (einzige KI-Schnittstelle, §3) ---
# IPv6-Host darf ungeklammert als host:port angegeben werden (wird zu [host]:port).
OLLAMA_URL=http://192.168.1.32:11434
OLLAMA_MODEL=hf.co/unsloth/Phi-4-mini-instruct-GGUF:Q4_K_M
# Kontextfenster (num_ctx). KLEIN lassen -> KV-Cache klein -> Antwort bleibt möglich.
# Der Coordinator reserviert CONTEXT_RESERVED_TOKENS für die Antwort (§8).
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_MS=15000
OLLAMA_TEMPERATURE=0.8
OLLAMA_TOP_P=0.95
OLLAMA_TOP_K=64

# --- QUEUE / WORKER ---
# Parallele Ollama-Requests (Lastbegrenzung §3/13). Nicht zu hoch; Ollama ist
# auf einem Rechner in der Regel seriell/GPU-lastig.
COORDINATOR_WORKERS=2
# Wenn mehr als QUEUE_MAX_SIZE Jobs anstehen, antwortet der Coordinator mit
# QUEUE_FULL und der Realm nutzt seine lokale Fallback-Reaktion (§4).
QUEUE_MAX_SIZE=200
# Cooldown zwischen zwei freien KI-Anfragen desselben Spielers (§6).
PLAYER_COOLDOWN_SECONDS=5
# Obergrenze einer freien Texteingabe in Zeichen (§7).
MAX_TEXT_CHARS=500
# Maximal 5 Korrektur-/Wiederholungsversuche pro Job (§11/12).
MAX_CORRECTION_ATTEMPTS=5
# Für die Antwort reservierter Token-Bereich im Kontextfenster (§8).
CONTEXT_RESERVED_TOKENS=1536

# --- PRIORITÄTEN (§5) ---
# Innerhalb derselben Priorität zählt die Eingangsreihenfolge (Datei-Timestamp).
PRIORITY_RAIDBOSS=100
PRIORITY_PLAYER=90
PRIORITY_CRAFT=90
PRIORITY_NPC=80
PRIORITY_EVENT=70
PRIORITY_BACKGROUND=30
PRIORITY_WORLD=10

# --- INHALTSREGELN (§9/10) ---
# Betreiber-Ergänzungen: Komma-/Semikolon-getrennte Begriffe. Die
# eigentlichen Sperrlisten liegen sprachdateibasiert in
# COORDINATOR_FILTER_DIR; die Env-Werte sind zusätzliche Betreiber-Einträge.
# INPUT_* wird vor jeder Ollama-Anfrage geprüft, OUTPUT_* auf jede Antwort.
INPUT_DENY_WORDS=
OUTPUT_DENY_WORDS=
# Erlaubte Schlüssel strukturierter Aktions-Antworten (nur "Vorschläge").
ALLOWED_ACTION_KEYS=intent,target,scope,confidence

# --- REGISTRIERTE REALMS ---
# Jeder Realmserver, der Jobs einreichen darf, braucht genau ein
# SERVICE_<name>_ID/_SECRET/_PERMISSIONS-Tupel plus die zugehörige
# REALM_<name>_ID (öffentliche Realm-ID aus Job-Payloads) und optional
# eine REALM_<name>_RESULT_URL (Push; leer = Realm pollt /v1/jobs/{id}).
#
# Beispiel Realm "de1":
#SERVICE_DE1_ID=realm-de1-service
#SERVICE_DE1_SECRET=CHANGE_ME
#SERVICE_DE1_PERMISSIONS=coordinator.jobs.submit,coordinator.jobs.query
#REALM_DE1_ID=de1
# Push-Ergebnis-Callback des Realms (IPv6-Host zulässig). Der Wert ist
# ein Deployment-Platzhalter — die tatsächliche Callback-Adresse legt der
# Betreiber je Realm fest und ist unabhängig von Ports alter Node-Realms.
# Leer = Realm pollt GET /v1/jobs/{id}.
#REALM_DE1_RESULT_URL=https://realm-de1.example.invalid/v1/coordinator/result

# --- KOORDINATOR-IDENTITÄT (für Ergebnis-Rückruf an Realms) ---
# Nur nötig, wenn REALM_<name>_RESULT_URL gesetzt ist.
COORDINATOR_SERVICE_ID=coordinator-service
COORDINATOR_SERVICE_SECRET=CHANGE_ME

# --- RATE-LIMIT (signierte Realm-Aufrufe) ---
# Der Coordinator verzichtet bewusst auf per-Client-IP-Limits und damit
# auf eine TRUSTED_PROXIES-Konfiguration: Identität ist das signierte
# Service-Credential, nicht die Quell-IP.
RATE_LIMIT_BURST=10
RATE_LIMIT_PER_MIN=120

# --- TLS (optional) ---
#TLS_CERT_FILE=
#TLS_KEY_FILE=
