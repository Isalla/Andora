[Unit]
Description=Andora MMO Server-Monitoring-Panel (eigener Prozess)
# Läuft unabhängig vom Gameserver; überlebt einen Game-Server-Crash.
After=andora-server.service

[Service]
Type=simple
# Der Monitoring-Prozess läuft NICHT als root.
User=pi
WorkingDirectory=/opt/andora/monitor
ExecStart=/usr/bin/node /opt/andora/monitor/server.js
# Panel-Umgebungsvariablen (Bind-Host/Port, Token, Zielpfad, ...) —
# siehe deploy/conf/monitor.conf
EnvironmentFile=-/opt/andora/monitor/monitor.conf
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=true
# Startet nicht erst, wenn der Dienst existiert; kein starker Abhängigkeitszwang:
After=network.target

[Install]
WantedBy=multi-user.target
