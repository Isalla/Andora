# server/config.env.example — kopieren nach config.env und Werte setzen
PORT_WS=3001
PORT_HTTP=3002
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=andora
DB_PASS=
DB_NAME=andora
TICK_MS=100
AOFB_RADIUS=20
OLLAMA_URL=http://192.168.1.32:11434
# NPC-Sprache: Phi-4-mini = schnell, skalierbar bei vielen Spielern (Default)
OLLAMA_MODEL=hf.co/unsloth/Phi-4-mini-instruct-GGUF:Q4_K_M
# Optional: schweres Modell nur fuer Boss-/Raid-Dialoge (leere Zeile = aus)
OLLAMA_MODEL_QUALITY=qwen3.8:27b
OLLAMA_TIMEOUT_MS=15000
OLLAMA_FALLBACK=1
# Ollama-Kontextfenster (num_ctx): KLEIN lassen -> KV-Cache klein ->
# Modell bleibt im VRAM, wird nicht von der CPU gebremst. 8192 reicht fuer
# 2-Satz-NPC-Antworten + ~10 Chat-Vorgaenge. Groessere Werte = mehr VRAM.
OLLAMA_NUM_CTX=8192
# Sampling-Parameter (standardisiert, pro Modell anpassbar):
# Empfehlung Google fuer Gemma-Reihe: t=1.0 / top_p=0.95 / top_k=64.
# Fuer kleine Modelle (Phi-4-mini) eher t=0.8 testen -> weniger wirres Zeug.
OLLAMA_TEMPERATURE=0.8
OLLAMA_TOP_P=0.95
OLLAMA_TOP_K=64
# Pro Qualitaetsmodell (Boss) eigene Werte, leer = obige nutzen
OLLAMA_TEMP_QUALITY=1.0
RENDER_CAP_DEFAULT=64
